<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext (http://) stays blocked globally, but Bilibili's CDN nodes
     occasionally serve audio over http:// or redirect across protocols.
     Allow it only for Bilibili-related domains. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">bilibili.com</domain>
        <domain includeSubdomains="true">bilivideo.com</domain>
        <domain includeSubdomains="true">hdslb.com</domain>
    </domain-config>
</network-security-config>
