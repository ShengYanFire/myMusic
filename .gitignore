# Android
android/.gradle/
android/.kotlin/
android/local.properties
android/app/build/
android/build/
android/assemble.log
*.iml
.idea/

# Debug artifacts at repo root (adb uiautomator dumps / logs / screenshots /
# pulled datastore snapshots) - they never belong in the repo
/*.xml
/*.png
/full-log.txt
/gfxinfo.txt
/library.pb.txt

# Built binaries never belong in the repo (a 22 MB tracked APK bloats every
# clone and every future commit's history)
/*.apk
/*.aab

# Signing keystores are secrets and must never be committed. .sandbox-home is
# the sandbox-only $HOME redirect that holds a copy of the debug keystore for
# offline/AGP9 signing (the sandbox can't write the real ~/.android).
*.keystore
*.jks
/.sandbox-home/

# Local scratch / reference-extract directories
/.gradle-tmp/
/nav-src/
/navc-src/
/navcmn-src/

# Machine-specific toolchain setup script (references local DevEco JDK path)
setup-toolchain.cmd

# OS
Thumbs.db
.DS_Store
